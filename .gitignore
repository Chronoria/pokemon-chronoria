# build output
dist/
# generated types
.astro/

# generated by data-import/buildData.ts - regenerated on every build, not committed
src/data/*.json
# same, but served as a static asset instead of imported (the damage calculator fetches it at
# runtime) - "npm run build" runs build-data before astro build, so it exists before public/ is
# copied into dist/
public/calc-data.json
Item-Uebersicht.xlsx
Pokemon-Uebersicht.xlsx
Routen-Uebersicht.xlsx
# Excel lock files for the two xlsx exports above - created while either is open, harmless but
# shouldn't be tracked (one slipped into a past commit while Excel had Item-Uebersicht.xlsx open)
~$*.xlsx

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/
