---
// One page per place with wild encounters. It works as a normal page, and the Pokémon pages load
// its #fundort-inhalt block into a pop-up (see components/FundortDialog.astro).
//
// A place can consist of several parts with different encounters. Each part shows the
// screenshots of its maps on top; a part without any screenshot yet gets a plain "Bereich N"
// heading instead, so the parts can still be told apart.
import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import { wildLocations } from "../../lib/locations";
import { encounterMethodLabel, formatEncounterChance } from "../../lib/encounterMethods";
import { href } from "../../lib/url";

export function getStaticPaths() {
  return wildLocations.map((location) => ({ params: { ort: location.slug }, props: { location } }));
}

const { location } = Astro.props;
---

<Layout title={`Fundort: ${location.name}`}>
  <PageHeader backHref={href("/fundorte/")} backLabel="← Alle Fundorte" title={location.name} />
  <div id="fundort-inhalt">
    <p class="meta-note">
      {location.speciesCount} wilde Pokémon. Die Häufigkeit gilt jeweils innerhalb einer Methode.
    </p>
    {location.blocks.map((block, index) => (
      <section class="fundort-block">
        {block.images.length > 0 ? (
          <div class={`fundort-maps${block.images.length === 1 ? " is-single" : ""}`}>
            {block.images.map((image) => (
              <a href={href(image)} target="_blank" rel="noopener" title="Karte in voller Größe öffnen">
                <img src={href(image)} alt={`Karte: ${location.name}`} loading="lazy" />
              </a>
            ))}
          </div>
        ) : location.blocks.length > 1 && (
          <h2>Bereich {index + 1}</h2>
        )}
        {block.tables.map((table) => (
          <>
            <h3>{encounterMethodLabel(table.method)}</h3>
            <table class="fundort-table">
              <tr><th>Pokémon</th><th>Level</th><th>Häufigkeit</th></tr>
              {table.slots.map((slot) => (
                <tr data-species={slot.speciesKey}>
                  <td>
                    <span class="fundort-species">
                      {slot.sprite && <img src={href(`/sprites/${slot.sprite}`)} alt="" loading="lazy" width="40" height="40" />}
                      {slot.path ? <a href={href(slot.path)}>{slot.name}</a> : slot.name}
                    </span>
                  </td>
                  <td>{slot.minLevel === slot.maxLevel ? slot.minLevel : `${slot.minLevel}–${slot.maxLevel}`}</td>
                  <td>{formatEncounterChance(slot.chance)}</td>
                </tr>
              ))}
            </table>
          </>
        ))}
      </section>
    ))}
  </div>
</Layout>
