---
import Layout from "../../layouts/Layout.astro";
import Card from "../../components/Card.astro";
import TypeBadge from "../../components/TypeBadge.astro";
import RandomButton from "../../components/RandomButton.astro";
import { pokemon, types, pokemonDexNumber } from "../../lib/data";
import { slugify } from "../../lib/data";
import { href } from "../../lib/url";
import { typeColor } from "../../lib/typeColors";

const randomHrefs = pokemon.map((p) => href(`/pokemon/${slugify(p.id)}/`));

// Forms (Mega Evolutions etc.) are rendered into the same grid so a type-filtered view shows
// species and forms together - see the note above the .filter-bar script for why they stay hidden
// until a specific type is picked. Same flattening formen/index.astro uses (female forms are
// cosmetic-only duplicates of the base sprite/stats, so they're excluded there too).
const allForms = pokemon.flatMap((p) =>
  p.forms
    .filter((f) => !f.isFemaleForm)
    .map((f) => ({
      p,
      f,
      label: f.formName?.text || `Form ${f.formNumber}`,
    }))
);
---

<Layout title="Pokémon">
  <h1>Pokémon ({pokemon.length})</h1>
  <RandomButton hrefs={randomHrefs} />

  <input
    type="search"
    id="name-search"
    class="text-input"
    placeholder="Nach Namen suchen…"
    aria-label="Pokémon nach Namen durchsuchen"
  />

  <div class="filter-bar" id="type-filter">
    <a href="#" data-type="ALL" aria-current="true">Alle</a>
    {types.filter((t) => t.id !== "QMARKS").map((t) => (
      <a href="#" data-type={t.id}>{t.name}</a>
    ))}
  </div>

  <p class="meta-note" id="result-count"></p>

  <div class="card-grid" id="pokemon-grid">
    {pokemon.map((p) => (
      <Card
        href={href(`/pokemon/${slugify(p.id)}/`)}
        data-types={p.types.join(",")}
        data-name={p.name.toLowerCase()}
        style={`--card-glow:${typeColor(p.types[0])}66`}
      >
        {p.sprite && <img class="card-sprite" src={href(`/sprites/${p.sprite}`)} alt="" loading="lazy" width="64" height="64" transition:name={`pokemon-sprite-${p.id}`} />}
        <div class="card-id">#{String(pokemonDexNumber.get(p.id)).padStart(3, "0")}</div>
        <div class="card-name">{p.name}</div>
        <div class="pill-list" style="margin-top:0.35rem">
          {p.types.map((t) => <TypeBadge type={t} />)}
        </div>
      </Card>
    ))}
    {allForms.map(({ p, f, label }) => (
      <Card
        href={href(`/pokemon/${slugify(p.id)}/${f.formNumber}/`)}
        data-kind="form"
        data-types={f.types.join(",")}
        data-name={`${p.name.toLowerCase()} ${label.toLowerCase()}`}
        style={`--card-glow:${typeColor(f.types[0])}66`}
      >
        {f.sprite && <img class="card-sprite" src={href(`/sprites/${f.sprite}`)} alt="" loading="lazy" width="64" height="64" />}
        <div class="card-name">{p.name}</div>
        <div class="meta-note">{label}</div>
        <div class="pill-list" style="margin-top:0.35rem">
          {f.types.map((t) => <TypeBadge type={t} />)}
        </div>
      </Card>
    ))}
  </div>
</Layout>

<script data-astro-rerun>
  // Block-scoped (see items/index.astro for why: data-astro-rerun re-inserts this exact script on
  // every revisit, and TS-only syntax below must be plain JS since the dynamic re-insertion isn't
  // passed back through Astro/esbuild's TS-stripping step the way the initial page load is.
  {
  const filterBar = document.getElementById("type-filter");
  const nameSearch = document.getElementById("name-search");
  const resultCount = document.getElementById("result-count");
  const grid = document.getElementById("pokemon-grid");
  const cards = [...grid.querySelectorAll("[data-types]")];

  let activeType = "ALL";

  function applyFilters() {
    const query = nameSearch.value.trim().toLowerCase();
    let visible = 0;
    for (const card of cards) {
      // Forms only join the list once a specific type is picked - normal browsing (activeType
      // "ALL") stays species-only, matching how this page looked before forms were added here.
      if (card.dataset.kind === "form" && activeType === "ALL") {
        card.style.display = "none";
        continue;
      }
      const cardTypes = card.dataset.types?.split(",") ?? [];
      const matchesType = activeType === "ALL" || cardTypes.includes(activeType);
      const matchesName = query === "" || (card.dataset.name ?? "").includes(query);
      const show = matchesType && matchesName;
      card.style.display = show ? "" : "none";
      if (show) visible++;
    }
    resultCount.textContent = query || activeType !== "ALL" ? `${visible} Treffer` : "";
  }

  filterBar.addEventListener("click", (e) => {
    const link = e.target.closest("a[data-type]");
    if (!link) return;
    e.preventDefault();
    activeType = link.getAttribute("data-type");

    for (const a of filterBar.querySelectorAll("a")) a.removeAttribute("aria-current");
    link.setAttribute("aria-current", "true");
    applyFilters();
  });

  // Lets a TypeBadge link straight into a pre-filtered list (e.g. "/pokemon/?typ=FIRE") instead of
  // needing a dedicated static page per type - reads the same "typ" query param TypeBadge.astro
  // builds when link=true (mirrors items/index.astro's "?kategorie=" reader).
  const initialType = new URLSearchParams(window.location.search).get("typ");
  if (initialType) {
    const initialLink = filterBar.querySelector(`a[data-type="${initialType}"]`);
    if (initialLink) {
      activeType = initialType;
      for (const a of filterBar.querySelectorAll("a")) a.removeAttribute("aria-current");
      initialLink.setAttribute("aria-current", "true");
    }
  }

  nameSearch.addEventListener("input", applyFilters);
  applyFilters();
  }
</script>
