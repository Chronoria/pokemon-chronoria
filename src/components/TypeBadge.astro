---
import { typeColor, mixColor, textColorFor } from "../lib/typeColors";
import { typeIcon } from "../lib/typeIcons";
import { typeNameById } from "../lib/data";
import { href } from "../lib/url";

interface Props {
  type: string;
  // Makes the badge a link into the type-filtered "/pokemon/?typ=..." list (which shows species
  // AND their forms together whenever a specific type is selected - see pokemon/index.astro).
  // Omitted by default so no existing call site changes behavior unless explicitly opted in -
  // several sit inside an outer <a> already (card grids, linked table rows) where a nested link
  // would be invalid HTML.
  link?: boolean;
}
const { type, link } = Astro.props;
const name = typeNameById.get(type) ?? type;
const color = typeColor(type);
const ink = textColorFor(type);
const textShadow =
  ink === "#ffffff" ? "0 1px 2px rgba(0,0,0,0.45)" : "0 1px 0 rgba(255,255,255,0.35)";
const style = `background:linear-gradient(155deg, ${mixColor(color, 25)}, ${mixColor(color, -35)}); box-shadow: 0 4px 14px -3px ${color}99, inset 0 1px 0 rgba(255,255,255,0.14); color: ${ink}; text-shadow: ${textShadow};`;
---

{link ? (
  <a class="badge badge-type badge-type-link" style={style} href={href(`/pokemon/?typ=${type}`)}>
    <svg class="badge-type-icon" viewBox="0 0 14 14" aria-hidden="true" set:html={typeIcon(type)} />
    {name}
  </a>
) : (
  <span class="badge badge-type" style={style}>
    <svg class="badge-type-icon" viewBox="0 0 14 14" aria-hidden="true" set:html={typeIcon(type)} />
    {name}
  </span>
)}
